// LifeSupply Command Center — Prisma schema
//
// Phase 1: identity, RBAC, audit logging.
// Phase 2: operating tables (divisions, stores, customers, products,
// orders, suppliers, financial summaries, marketing, analytics, tasks,
// reports, AI outputs, integration logs).
//
// Source: docs/04_DATABASE_SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

// Two URLs so the same schema works in both local Docker (single connection)
// and Vercel + Neon (pooled connection at runtime, direct connection for
// migrations).
//
//   DATABASE_URL  — pooled (PgBouncer / Neon serverless) — used by the app
//                   at runtime for normal queries.
//   DIRECT_URL    — direct connection (port 5432, no pooler) — used by
//                   `prisma migrate deploy` because Prisma needs an
//                   advisory lock that pooled connections do not support.
//
// In local dev they can be the same value; the .env.example only shows
// DATABASE_URL since the docker-compose Postgres has no pooler.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Identity & Access Control
// =============================================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  status       UserStatus @default(active)
  title        String?
  department   String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userRoles                   UserRole[]
  auditLogs                   AuditLog[]            @relation("ActorAuditLogs")
  createdTasks                Task[]                @relation("TaskCreator")
  assignedTasks               Task[]                @relation("TaskAssignee")
  preparedReports             Report[]              @relation("ReportPreparedBy")
  approvedReports             Report[]              @relation("ReportApprovedBy")
  requestedApprovals          Approval[]            @relation("ApprovalRequester")
  decidedApprovals            Approval[]            @relation("ApprovalApprover")
  aiOutputs                   AiOutput[]
  triggeredSyncs              IntegrationSyncLog[]  @relation("SyncTriggeredBy")
  investorInteractionsCreated InvestorInteraction[] @relation("InvestorInteractionCreator")
  ownedOpportunities          Opportunity[]         @relation("OpportunityOwner")
  assignedExceptions          Exception[]           @relation("ExceptionAssignee")
  resolvedExceptions          Exception[]           @relation("ExceptionResolver")
  approvedAdjustments         FinancialAdjustment[] @relation("AdjustmentApprover")
  createdAdjustments          FinancialAdjustment[] @relation("AdjustmentCreator")
  createdBudgets              Budget[]              @relation("BudgetCreator")
  ownedCloseTasks             MonthlyCloseTask[]    @relation("CloseTaskOwner")
  completedCloseTasks         MonthlyCloseTask[]    @relation("CloseTaskCompleter")
  triggeredAutomationRuns     AutomationRun[]       @relation("AutomationRunTrigger")
  ownedCapitalRaises          CapitalRaise[]        @relation("CapitalRaiseOwner")
  createdCommitments          CapitalRaiseCommitment[] @relation("CommitmentCreator")
  ownedDiligenceItems         DiligenceItem[]       @relation("DiligenceOwner")
  completedDiligenceItems     DiligenceItem[]       @relation("DiligenceCompleter")
  preparedInvestorUpdates     InvestorUpdate[]      @relation("InvestorUpdatePreparer")
  approvedInvestorUpdates     InvestorUpdate[]      @relation("InvestorUpdateApprover")
  reconciliationRuns          ReconciliationReport[] @relation("ReconciliationTriggeredBy")
  savedViews                  SavedView[]            @relation("SavedViewOwner")
  forecastsCreated            ForecastScenario[]     @relation("ForecastCreator")
  forecastsApproved           ForecastScenario[]     @relation("ForecastApprover")
  agentRuns                   AgentRun[]             @relation("AgentRunTrigger")
  productStudioProjects       ProductStudioProject[] @relation("ProductStudioCreator")
  pricingRunsCreated          PricingRun[]           @relation("PricingRunCreator")
  priceRecommendationsApproved PriceRecommendation[] @relation("PriceRecommendationApprover")
  priceRecommendationsRejected PriceRecommendation[] @relation("PriceRecommendationRejecter")
  priceWritebacksWritten      PriceWritebackLog[]    @relation("PriceWritebackWriter")
  productCompetitorUrlsVerified ProductCompetitorUrl[] @relation("ProductCompetitorUrlVerifier")

  @@index([status])
  @@map("users")
}

enum UserStatus {
  invited
  active
  suspended
  archived
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// Audit Logging — docs/06 §9
// =============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  beforeData  Json?
  afterData   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Business Structure — divisions and stores
// docs/04 §4
// =============================================================================

model Division {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  type             String? // operating, holding, geographic, consolidated
  jurisdiction     String? // CA, US, etc.
  parentDivisionId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentDivision     Division?             @relation("DivisionTree", fields: [parentDivisionId], references: [id], onDelete: SetNull)
  childDivisions     Division[]            @relation("DivisionTree")
  stores             Store[]
  customers          Customer[]
  products           Product[]
  orders             Order[]
  financialSummaries FinancialSummary[]
  financialAdjustments FinancialAdjustment[]
  budgets            Budget[]
  monthlyCloseTasks  MonthlyCloseTask[]

  @@map("divisions")
}

model Store {
  id              String   @id @default(cuid())
  divisionId      String
  name            String
  platform        String // bigcommerce, amazon, manual, other
  url             String?
  sourceSystem    String?
  externalStoreId String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  division               Division                @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  customers              Customer[]
  categories             Category[]
  products               Product[]
  orders                 Order[]
  websiteMetrics         WebsiteMetric[]
  integrationConnections IntegrationConnection[]
  reconciliationReports  ReconciliationReport[]
  pricingRules           PricingRule[]
  pricingRuns            PricingRun[]
  pricingRunItems        PricingRunItem[]
  priceWritebackLogs     PriceWritebackLog[]

  @@unique([sourceSystem, externalStoreId])
  @@index([divisionId])
  @@map("stores")
}

// =============================================================================
// Customers — docs/04 §5.1–5.3
// =============================================================================

model Customer {
  id                String        @id @default(cuid())
  storeId           String?
  divisionId        String?
  sourceSystem      String?
  sourceId          String?
  email             String?
  firstName         String?
  lastName          String?
  companyName       String?
  customerType      CustomerType  @default(unknown)
  phone             String?
  billingAddress    Json?
  shippingAddress   Json?
  consentStatus     ConsentStatus @default(unknown)
  /// CASL evidence fields (Phase 4): why we may (or may not) email this person.
  consentBasis      ConsentBasis  @default(unknown)
  consentSource     String? // mailchimp, checkout_optin, manual, order_history
  consentObtainedAt DateTime?
  consentExpiresAt  DateTime?
  suppressionReason String? // mailchimp_unsubscribed, mailchimp_cleaned_bounced, mailchimp_abuse_complaint, manual
  suppressedAt      DateTime?
  mailchimpStatus   String?
  lifetimeValue     Decimal       @default(0) @db.Decimal(14, 2)
  orderCount        Int           @default(0)
  firstOrderAt      DateTime?
  lastOrderAt       DateTime?
  reactivationScore Int? // 0–100, higher = better reactivation candidate
  notes             String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  store             Store?                  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  division          Division?               @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  orders            Order[]
  marketingContacts MarketingContact[]
  segmentMembers    CustomerSegmentMember[]

  @@unique([sourceSystem, sourceId])
  @@index([email])
  @@index([customerType])
  @@index([divisionId])
  @@index([storeId])
  @@map("customers")
}

enum CustomerType {
  retail
  b2b
  clinic
  institutional
  supplier
  investor
  unknown
}

enum ConsentStatus {
  subscribed
  unsubscribed
  cleaned
  transactional
  pending
  unknown
  complained
}

/// CASL consent basis (Phase 4 — docs/19). Marketing sends require documented
/// express consent, or implied consent inside its validity window. Everything
/// else is ineligible — never assume eligibility without evidence.
enum ConsentBasis {
  express
  implied
  transactional_only
  unknown
}

model CustomerSegment {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  segmentType  String // reactivation, vip, lapsed, b2b, retail, custom
  criteria     Json?
  sourceSystem String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members CustomerSegmentMember[]

  @@map("customer_segments")
}

model CustomerSegmentMember {
  id         String    @id @default(cuid())
  customerId String
  segmentId  String
  addedAt    DateTime  @default(now())
  removedAt  DateTime?

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment  CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([customerId, segmentId])
  @@index([segmentId])
  @@map("customer_segment_members")
}

// =============================================================================
// Products & Catalog — docs/04 §5.4–5.7
// =============================================================================

model Category {
  id               String   @id @default(cuid())
  storeId          String?
  sourceSystem     String?
  sourceId         String?
  name             String
  path             String?
  parentCategoryId String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store           Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  parentCategory  Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories Category[] @relation("CategoryTree")
  products        Product[]
  pricingRules    PricingRule[]

  @@unique([sourceSystem, sourceId])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id                  String            @id @default(cuid())
  storeId             String?
  divisionId          String?
  categoryId          String?
  sourceSystem        String?
  sourceId            String?
  name                String
  sku                 String?
  brand               String?
  description         String?           @db.Text
  url                 String?
  imageStatus         DataQualityStatus @default(missing)
  descriptionStatus   DataQualityStatus @default(missing)
  status              ProductStatus     @default(active)
  productType         String?
  isFeatured          Boolean           @default(false)
  isRockstarCandidate Boolean           @default(false)
  metadata            Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  store            Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  division         Division?         @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  orderItems       OrderItem[]
  supplierProducts SupplierProduct[]
  studioProjects   ProductStudioProject[]
  pricingRules     PricingRule[]
  pricingRunItems  PricingRunItem[]
  priceWritebackLogs PriceWritebackLog[]
  competitorUrls   ProductCompetitorUrl[]

  @@unique([sourceSystem, sourceId])
  @@index([storeId])
  @@index([categoryId])
  @@index([sku])
  @@index([status])
  @@map("products")
}

enum ProductStatus {
  draft
  active
  inactive
  archived
}

enum DataQualityStatus {
  missing
  present
  needs_review
  validated
}

// =============================================================================
// Product Studio — researched, review-only product listing and image drafts.
// The original uploaded photographs are the authoritative visual source.
// Competitor imagery is referenced by URL and composition attributes only.
// =============================================================================

model ProductStudioProject {
  id                String                     @id @default(cuid())
  productId         String?
  createdById       String?
  title             String
  shortDescription  String                     @db.Text
  confirmedTitle    String?
  finalDescription  String?                    @db.Text
  status            ProductStudioProjectStatus @default(draft)
  currency          String                     @default("CAD")
  marketLow         Decimal?                   @db.Decimal(12, 2)
  marketHigh        Decimal?                   @db.Decimal(12, 2)
  marketMedian      Decimal?                   @db.Decimal(12, 2)
  researchSummary   Json?
  warnings          String[]
  errorMessage      String?                    @db.Text
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  product           Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy         User?                      @relation("ProductStudioCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assets            ProductStudioAsset[]
  researchSources   ProductStudioResearchSource[]
  priceObservations ProductStudioPriceObservation[]
  compositions      ProductStudioComposition[]

  @@index([productId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("product_studio_projects")
}

enum ProductStudioProjectStatus {
  draft
  research_queued
  researching
  ready_to_generate
  generating
  needs_review
  approved
  failed
  archived
}

model ProductStudioAsset {
  id             String                   @id @default(cuid())
  projectId      String
  kind           ProductStudioAssetKind
  compositionSlot Int?
  revision       Int                      @default(1)
  fileName       String
  contentType    String
  bytes          Int
  data           Bytes
  contentHash    String
  width          Int?
  height         Int?
  prompt         String?                  @db.Text
  modelName      String?
  status         ProductStudioAssetStatus @default(uploaded)
  qaResult       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  project ProductStudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, compositionSlot, revision])
  @@index([projectId])
  @@index([status])
  @@map("product_studio_assets")
}

enum ProductStudioAssetKind {
  source
  generated
}

enum ProductStudioAssetStatus {
  uploaded
  queued
  generating
  needs_review
  approved
  rejected
  failed
}

model ProductStudioResearchSource {
  id           String   @id @default(cuid())
  projectId    String
  sellerName   String
  pageTitle    String?
  url          String
  heroImageUrl String?
  sourceType   String?
  notes        String?  @db.Text
  capturedAt   DateTime @default(now())

  project ProductStudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, url])
  @@index([projectId])
  @@map("product_studio_research_sources")
}

model ProductStudioPriceObservation {
  id                  String   @id @default(cuid())
  projectId           String
  sellerName          String
  url                 String
  price               Decimal  @db.Decimal(12, 2)
  currency            String
  condition           String?
  includedAccessories String?
  notes               String?  @db.Text
  observedAt          DateTime @default(now())

  project ProductStudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([observedAt])
  @@map("product_studio_price_observations")
}

model ProductStudioComposition {
  id                String                         @id @default(cuid())
  projectId         String
  slot              Int
  name              String
  sourceSeller      String?
  sourceUrl         String?
  referenceImageUrl String?
  rationale         String                        @db.Text
  attributes        Json
  prompt            String                        @db.Text
  status            ProductStudioCompositionStatus @default(planned)
  errorMessage      String?                       @db.Text
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  project ProductStudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slot])
  @@index([projectId])
  @@index([status])
  @@map("product_studio_compositions")
}

enum ProductStudioCompositionStatus {
  planned
  queued
  generating
  generated
  failed
}

model ProductVariant {
  id                    String        @id @default(cuid())
  productId             String
  sku                   String
  optionSummary         String?
  price                 Decimal       @db.Decimal(12, 2)
  salePrice             Decimal?      @db.Decimal(12, 2)
  costPrice             Decimal?      @db.Decimal(12, 2)
  inventoryTrackingType String? // none, bigcommerce, supplier
  stockLevel            Int?
  status                ProductStatus @default(active)
  sourceSystem          String?
  sourceId              String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  supplierProducts SupplierProduct[]
  pricingRules     PricingRule[]
  pricingRunItems  PricingRunItem[]
  priceWritebackLogs PriceWritebackLog[]
  competitorUrls   ProductCompetitorUrl[]

  @@unique([sourceSystem, sourceId])
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// =============================================================================
// Orders — docs/04 §5.8–5.9
// =============================================================================

model Order {
  id                   String                 @id @default(cuid())
  storeId              String
  divisionId           String?
  customerId           String?
  sourceSystem         String?
  sourceId             String?
  orderNumber          String
  status               OrderStatus            @default(received)
  paymentStatus        PaymentStatus          @default(pending)
  fulfillmentStatus    FulfillmentStatus      @default(unfulfilled)
  orderDate            DateTime
  subtotal             Decimal                @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal                @default(0) @db.Decimal(12, 2)
  shippingTotal        Decimal                @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal                @default(0) @db.Decimal(12, 2)
  grandTotal           Decimal                @default(0) @db.Decimal(12, 2)
  currency             String                 @default("CAD")
  /// Payment method label from the source system (Phase 3D), e.g. "Visa".
  paymentMethod        String?
  /// Total refunded to date from the source system (Phase 3D).
  refundedTotal        Decimal                @default(0) @db.Decimal(12, 2)
  estimatedGrossProfit Decimal?               @db.Decimal(12, 2)
  estimatedGrossMargin Decimal?               @db.Decimal(5, 4)
  supplierStatus       SupplierWorkflowStatus @default(not_required)
  automationStatus     AutomationStatus       @default(none)
  exceptionStatus      ExceptionStatus        @default(none)
  exceptionReason      String?
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  division       Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  shipments      OrderShipment[]
  automationRuns AutomationRun[]

  @@unique([sourceSystem, sourceId])
  @@unique([storeId, orderNumber])
  @@index([orderDate])
  @@index([status])
  @@index([exceptionStatus])
  @@index([customerId])
  @@map("orders")
}

/// A point-in-time comparison of Command Center totals against BigCommerce
/// source totals for one store (Phase 3E — docs/19). `metrics` is an array of
/// { metric, ccValue, bcValue, delta, deltaPct, material, note } rows; material
/// discrepancies also raise Exception rows so gaps surface instead of hiding.
model ReconciliationReport {
  id               String   @id @default(cuid())
  storeId          String
  triggeredById    String?
  rangeStart       DateTime
  rangeEnd         DateTime
  status           String // ok | discrepancies | failed
  metrics          Json?
  discrepancyCount Int      @default(0)
  errorSummary     String?  @db.Text
  createdAt        DateTime @default(now())

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  triggeredBy User? @relation("ReconciliationTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@map("reconciliation_reports")
}

/// A shipment/fulfillment record for an order (Phase 3D — docs/19). Imported
/// from the source system (BigCommerce /v2/orders/{id}/shipments); carries the
/// tracking reference for operations + customer-service workflows.
model OrderShipment {
  id             String    @id @default(cuid())
  orderId        String
  sourceSystem   String?
  sourceId       String?
  shippedAt      DateTime?
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  itemsCount     Int       @default(0)
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, sourceId])
  @@index([orderId])
  @@map("order_shipments")
}

enum OrderStatus {
  received
  processing
  awaiting_supplier
  in_supplier_queue
  awaiting_human_review
  shipped
  delivered
  completed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum FulfillmentStatus {
  unfulfilled
  partially_fulfilled
  fulfilled
  returned
}

enum SupplierWorkflowStatus {
  not_required
  pending_assignment
  assigned
  awaiting_confirmation
  confirmed
  shipped
  completed
  failed
}

enum AutomationStatus {
  none
  queued
  running
  succeeded
  failed
  paused
}

enum ExceptionStatus {
  none
  flagged
  in_review
  resolved
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  productId            String?
  productVariantId     String?
  /// Source system + id for imported line items (BigCommerce order-product id).
  /// Enables idempotent upsert while preserving CC-owned cost/margin fields
  /// (Phase 3B). Null for manually-added items.
  sourceSystem         String?
  sourceId             String?
  sku                  String
  productName          String
  quantity             Int
  unitPrice            Decimal  @db.Decimal(12, 2)
  unitCost             Decimal? @db.Decimal(12, 2)
  lineSubtotal         Decimal  @db.Decimal(12, 2)
  lineTax              Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal            Decimal  @db.Decimal(12, 2)
  estimatedGrossProfit Decimal? @db.Decimal(12, 2)
  estimatedGrossMargin Decimal? @db.Decimal(5, 4)
  supplierId           String?
  supplierProductId    String?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant  ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, sourceId])
  @@index([orderId])
  @@index([productId])
  @@index([supplierId])
  @@map("order_items")
}

// =============================================================================
// Suppliers — docs/04 §6
// =============================================================================

model Supplier {
  id                  String    @id @default(cuid())
  name                String
  code                String    @unique
  type                String? // distributor, manufacturer, dropship, marketplace
  websiteUrl          String?
  portalUrl           String?
  apiAvailable        Boolean   @default(false)
  automationAvailable Boolean   @default(false)
  status              String    @default("active")
  primaryContactName  String?
  primaryContactEmail String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  supplierProducts SupplierProduct[]
  orderItems       OrderItem[]
  automationRuns   AutomationRun[]

