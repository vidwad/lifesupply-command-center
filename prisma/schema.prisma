// =============================================================================
// Exceptions — first-class entity for items that need attention.
// docs/17 §6 + §15 #2/#3. Order-level exception fields remain on the Order
// model; this table aggregates exceptions across orders, suppliers, products,
// financials so they can be assigned, aged, and escalated centrally.
// =============================================================================

model Exception {
  id           String            @id @default(cuid())
  exceptionType ExceptionType
  severity     ExceptionSeverity @default(medium)
  status       ExceptionState    @default(open)
  title        String
  description  String?           @db.Text
  /// What this exception is about. Examples:
  /// "order"/"<order id>", "supplier"/"<supplier id>", "product"/"<product id>",
  /// "financial_summary"/"<id>", "import"/"<sync log id>".
  entityType   String?
  entityId     String?
  /// Stable key used to group recurring instances of the same problem.
  /// Example: "supplier:BBM01:price_mismatch:SKU-123".
  recurringKey String?
  /// What raised this exception (manual, integration name, automation run).
  source       String?
  assignedToId String?
  resolvedById String?
  resolvedAt   DateTime?
  resolutionNotes String? @db.Text
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignedTo User? @relation("ExceptionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ExceptionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([exceptionType])
  @@index([entityType, entityId])
  @@index([recurringKey])
  @@index([createdAt])
  @@map("exceptions")
}

enum ExceptionType {
  order_delay
  order_payment
  order_address
  supplier_stock
  supplier_price_mismatch
  supplier_sku_mismatch
  product_missing_cost
  product_missing_image
  product_low_margin
  financial_import
  ai_output_review
  integration_sync
  other
}

enum ExceptionSeverity {
  low
  medium
  high
  urgent
}

// =============================================================================
// Agent runs — Phase 10 AI agent operating layer (docs/19 §10, docs/09).
// One row per agent invocation. Agents only read/analyze/draft/recommend;
// the structured output lives here (and in the linked AiOutput), and any
// task created from a recommendation is an explicit human action recorded
// in createdTaskIds. Tool skips (missing permissions) are preserved so a
// reviewer can see exactly what the agent did and did not have access to.
// =============================================================================

model AgentRun {
  id            String    @id @default(cuid())
  agentKey      String
  status        String // running, succeeded, failed
  triggeredById String?
  /// Run parameters supplied by the user (e.g. orderId for service drafts).
  params        Json?
  /// Tool keys whose data was collected for this run.
  toolKeysUsed  String[]
  /// Tools skipped because the triggering user lacked their permission.
  skippedTools  Json?
  /// Source descriptions per collected tool (docs/09 §12 grounding).
  sourceReferences Json?
  /// Validated structured output (agentOutputSchema envelope).
  outputJson    Json?
  summary       String?   @db.Text
  errorSummary  String?   @db.Text
  aiOutputId    String?
  /// Tasks a human created from this run's recommendations.
  createdTaskIds String[]
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  triggeredBy User?     @relation("AgentRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  aiOutput    AiOutput? @relation("AgentRunOutput", fields: [aiOutputId], references: [id], onDelete: SetNull)

  @@index([agentKey, startedAt])
  @@index([status])
  @@index([triggeredById])
  @@map("agent_runs")
}

// =============================================================================
// Forecast scenarios — versioned management forecasts (Phase 9, docs/12 §11).
// Forecasts are NEVER facts: every row stores the assumptions that produced
// it, the source periods it extrapolates, a data-freshness stamp, and the
// standing limitations list. Saving a scenario under an existing name creates
// a new version; approval (for external use) goes through an Approval row of
// type "forecast" and never mutates actuals.
// =============================================================================

model ForecastScenario {
  id            String                 @id @default(cuid())
  name          String
  version       Int                    @default(1)
  status        ForecastScenarioStatus @default(draft)
  /// Projection method key from the forecast engine.
  method        String
  horizonMonths Int
  /// Full ForecastAssumptions object (method params + scenario overlays).
  assumptions   Json
  /// Historical input series actually used (revenue + margin per period).
  inputs        Json
  /// Engine output rows (baseline vs scenario per period).
  results       Json
  /// Source periods + freshness (QBO last sync, latest closed period, etc.).
  sourceReferences Json?
  /// Standing limitations snapshot at generation time.
  limitations   Json?
  notes         String?                @db.Text
  createdById   String?
  approvalId    String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  createdBy  User? @relation("ForecastCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("ForecastApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([name, version])
  @@index([status])
  @@index([createdAt])
  @@map("forecast_scenarios")
}

enum ForecastScenarioStatus {
  draft
  under_review
  approved
  archived
}

// =============================================================================
// Saved views — per-user named filter presets for operations queues (Phase 8).
// `page` is the dashboard route key ("operations", "operations/exceptions",
// "orders", "tasks"); `params` stores the sanitized query-string filters.
// =============================================================================

model SavedView {
  id        String   @id @default(cuid())
  userId    String
  page      String
  name      String
  params    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("SavedViewOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page, name])
  @@index([userId, page])
  @@map("saved_views")
}

enum ExceptionState {
  open
  investigating
  blocked
  resolved
  dismissed
}

// =============================================================================
// Prompt Templates — versioned prompt library used by the AI service.
// docs/14 §10 + docs/17 §15 #6. Each invocation should reference the template
// id + version on the AiOutput row so historical outputs remain auditable
// after templates are revised.
// =============================================================================

model PromptTemplate {
  id              String            @id @default(cuid())
  /// Stable lookup key — e.g. "dashboard_briefing", "analyst_query".
  key             String
  version         Int               @default(1)
  name            String
  description     String?
  /// Default provider; the AI service may still route to another provider
  /// based on settings or task hints.
  provider        AiModelProvider   @default(anthropic)
  modelHint       String?
  systemPrompt    String            @db.Text
  /// User-message template. May contain `{{variable}}` placeholders rendered
  /// at runtime; rendering is done in the AI service, not the DB.
  userTemplate    String            @db.Text
  outputSchema    Json?
  /// Tags used to gate the template — e.g. ["financial","customer"]. The AI
  /// service combines these with the calling user's permissions before use.
  contextTags     String[]
  isActive        Boolean           @default(true)
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([key, version])
  @@index([key])
  @@index([isActive])
  @@map("prompt_templates")
}

// =============================================================================
// Financial Management — docs/12
// Adjustments, budgets, forecasts, and monthly close tasks. QuickBooks remains
// the accounting source of truth (CLAUDE.md §17); this layer is for the
// management adjustments + reporting view sitting on top of QBO imports.
// =============================================================================

model FinancialAdjustment {
  id                String         @id @default(cuid())
  financialPeriodId String
  divisionId        String?
  category          String // ebitda_addback, normalization, one_time, owner_compensation, other
  accountKey        String?
  amount            Decimal        @db.Decimal(14, 2)
  currency          String         @default("CAD")
  description       String         @db.Text
  approvalStatus    ApprovalStatus @default(pending)
  approvedById      String?
  approvedAt        DateTime?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  financialPeriod FinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)
  division        Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  approvedBy      User?           @relation("AdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("AdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([financialPeriodId])
  @@index([divisionId])
  @@index([category])
  @@map("financial_adjustments")
}

model Budget {
  id          String   @id @default(cuid())
  name        String
  year        Int
  divisionId  String?
  currency    String   @default("CAD")
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  division  Division?    @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     BudgetLine[]

  @@unique([year, divisionId, name])
  @@index([year])
  @@map("budgets")
}

model BudgetLine {
  id        String   @id @default(cuid())
  budgetId  String
  periodId  String
  /// Account category from the chart of accounts: "revenue", "cogs",
  /// "operating_expenses", "ebitda", etc. Matches FinancialSummary columns.
  accountKey String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  budget Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  period FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodId, accountKey])
  @@index([budgetId])
  @@index([periodId])
  @@map("budget_lines")
}

model MonthlyCloseTask {
  id                String              @id @default(cuid())
  financialPeriodId String
  divisionId        String?
  taskKey           String // standard close-task identifier, e.g. "bank_recon", "ap_recon"
  title             String
  description       String?
  ownerId           String?
  status            MonthlyCloseStatus  @default(pending)
  dueDate           DateTime?
  completedById     String?
  completedAt       DateTime?
  notes             String?             @db.Text
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  financialPeriod FinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)
  division        Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  owner           User?           @relation("CloseTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedBy     User?           @relation("CloseTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([financialPeriodId, divisionId, taskKey])
  @@index([financialPeriodId, status])
  @@index([ownerId, status])
  @@map("monthly_close_tasks")
}

enum MonthlyCloseStatus {
  pending
  in_progress
  blocked
  done
  skipped
}

// =============================================================================
// Report Templates — docs/11. Mirror of PromptTemplate for report generators.
// The Report model already supports per-row versioning; ReportTemplate gives
// us a versioned registry of report types (daily_brief, monthly_management,
// supplier_performance, etc.) so generators can be swapped without code.
// =============================================================================

model ReportTemplate {
  id          String   @id @default(cuid())
  /// Stable lookup key — e.g. "monthly_management", "daily_brief".
  key         String
  version     Int      @default(1)
  name        String
  description String?
  /// Optional PromptTemplate key for the AI commentary section.
  aiPromptKey String?
  /// Tags shown in the UI + used for filtering: ["financial", "investor"…]
  contextTags String[]
  /// JSON layout describing sections + data sources. The generator interprets
  /// this; nothing is enforced at the DB level.
  layout      Json?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, version])
  @@index([key])
  @@index([isActive])
  @@map("report_templates")
}

// =============================================================================
// Supplier Automation — docs/10 + docs/17 §7
// All runs start as `prepared` and require a matching Approval row before
// any actual portal submission can happen. The `supplier.automation` and
// `supplier.order_submit` FeatureFlags gate the runner. Per CLAUDE.md §14,
// supplier portals are NEVER hit without:
//   1. A user-triggered AutomationRun
//   2. supplier.automation flag on
//   3. (for submission) an Approval row + supplier.order_submit flag on
// Evidence (screenshots, response payloads) is attached as AutomationEvidence.
// =============================================================================

model AutomationRun {
  id           String                @id @default(cuid())
  workflow     AutomationWorkflow
  supplierId   String?
  orderId      String?
  triggeredById String?
  status       AutomationRunStatus   @default(prepared)
  /// Free-form description shown in the UI. Generated by the workflow.
  summary      String?
  /// Validation findings (price mismatch, sku miss, etc.).
  validationFlags Json?
  /// Result body or final payload (e.g. supplier confirmation number).
  result       Json?
  /// Error summary when status is failed.
  errorSummary String?               @db.Text
  startedAt    DateTime              @default(now())
  completedAt  DateTime?
  /// Approval row authorizing live submission; null when run is dry-run only.
  approvalId   String?
  metadata     Json?

  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  triggeredBy User?               @relation("AutomationRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  steps       AutomationStep[]
  evidence    AutomationEvidence[]

  @@index([status])
  @@index([supplierId, workflow])
  @@index([orderId])
  @@index([startedAt])
  @@map("automation_runs")
}

enum AutomationWorkflow {
  price_check
  stock_check
  sku_check
  prepare_order
  submit_order
}

enum AutomationRunStatus {
  prepared
  awaiting_approval
  approved
  running
  succeeded
  failed
  cancelled
}

model AutomationStep {
  id              String   @id @default(cuid())
  runId           String
  stepKey         String
  /// Sortable order — typically 0..N.
  sortOrder       Int      @default(0)
  status          String // pending, running, succeeded, failed, skipped
  startedAt       DateTime?
  completedAt     DateTime?
  output          Json?
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, sortOrder])
  @@map("automation_steps")
}

model AutomationEvidence {
  id           String   @id @default(cuid())
  runId        String
  stepId       String?
  kind         String // screenshot, html, json, file
  /// Storage reference. `db:<sha256>` when the payload lives in `data`;
  /// S3-style refs can replace this later without a schema change.
  storageRef   String
  /// Display label for the UI.
  label        String?
  description  String?  @db.Text
  contentHash  String?
  bytes        Int?
  /// Durable payload (Phase 7). Screenshots are small PNGs; runs are low
  /// volume, so Postgres is the honest durable store until S3 lands.
  data         Bytes?
  contentType  String?
  capturedAt   DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([capturedAt])
  @@map("automation_evidence")
}

// =============================================================================
// Capital Raises — docs/18 §3
// Tracks active capital-raising rounds + named investor commitments. The
// Investor model continues to be the contact-level record; CapitalRaise +
// CapitalRaiseCommitment are the per-round + per-position records.
// =============================================================================

model CapitalRaise {
  id              String           @id @default(cuid())
  name            String
  /// e.g. "seed", "series_a", "bridge", "credit_facility", "convertible".
  roundType       String
  status          CapitalRaiseStatus @default(planning)
  targetAmount    Decimal          @db.Decimal(14, 2)
  /// Fully-diluted pre-money valuation in CAD. Optional for debt rounds.
  preMoneyValuation Decimal?       @db.Decimal(14, 2)
  currency        String           @default("CAD")
  openedAt        DateTime?
  closedAt        DateTime?
  description     String?          @db.Text
  ownerId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner       User?                    @relation("CapitalRaiseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  commitments CapitalRaiseCommitment[]

  @@index([status])
  @@map("capital_raises")
}

enum CapitalRaiseStatus {
  planning
  open
  closing
  closed
  cancelled
}

model CapitalRaiseCommitment {
  id            String              @id @default(cuid())
  capitalRaiseId String
  investorId    String?
  /// Free-text name when the investor isn't (yet) in our investor CRM.
  investorLabel String?
  amount        Decimal             @db.Decimal(14, 2)
  status        CommitmentStatus    @default(soft)
  /// Date the commitment was signed / wired / etc.
  effectiveAt   DateTime?
  notes         String?             @db.Text
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  capitalRaise CapitalRaise @relation(fields: [capitalRaiseId], references: [id], onDelete: Cascade)
  investor     Investor?    @relation(fields: [investorId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("CommitmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([capitalRaiseId, status])
  @@index([investorId])
  @@map("capital_raise_commitments")
}

enum CommitmentStatus {
  soft
  signed
  funded
  withdrawn
  declined
}

// =============================================================================
// Diligence Items — docs/18 §6
// Per-opportunity / per-acquisition-target diligence checklist. Mirror of the
// MonthlyCloseTask pattern: standard-task seed via service helper, per-item
// status transitions, audit trail.
// =============================================================================

model DiligenceItem {
  id            String           @id @default(cuid())
  opportunityId String
  category      DiligenceCategory
  itemKey       String
  title         String
  description   String?
  ownerId       String?
  status        DiligenceStatus  @default(pending)
  dueDate       DateTime?
  completedById String?
  completedAt   DateTime?
  notes         String?          @db.Text
  /// Reference to a stored evidence file (URL or storage ref). Free-form for
  /// now — promote to its own model if multi-file evidence is required.
  evidenceRef   String?
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  owner       User?       @relation("DiligenceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedBy User?       @relation("DiligenceCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([opportunityId, itemKey])
  @@index([opportunityId, status])
  @@index([ownerId, status])
  @@map("diligence_items")
}

enum DiligenceCategory {
  financial
  legal
  operational
  commercial
  technology
  hr
  regulatory
  other
}

enum DiligenceStatus {
  pending
  in_progress
  blocked
  done
  not_applicable
}

// =============================================================================
// Investor Updates — docs/18 §4
// Drafted (often AI-assisted), reviewed, approved, then released to a
// recorded distribution list. Distribution itself is not wired in this
// phase — the released_at + distribution snapshot are persisted so the
// real send (email / data-room post) can be added later behind the
// `investor.distribution` feature flag.
// =============================================================================

model InvestorUpdate {
  id                 String              @id @default(cuid())
  title              String
  /// Period the update covers — usually a closed FinancialPeriod name.
  periodLabel        String?
  financialPeriodId  String?
  status             InvestorUpdateStatus @default(draft)
  bodyDraft          String?             @db.Text
  /// Bullet highlights surfaced in the email/preview.
  highlights         String[]
  /// Snapshot of {investorId, name, email} at draft time so the approver
  /// sees who would receive this even if the investor list changes later.
  distributionSnapshot Json?
  aiOutputId         String?
  preparedById       String?
  approvedById       String?
  approvedAt         DateTime?
  releasedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  financialPeriod FinancialPeriod? @relation(fields: [financialPeriodId], references: [id], onDelete: SetNull)
  preparedBy      User?            @relation("InvestorUpdatePreparer", fields: [preparedById], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("InvestorUpdateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  aiOutput        AiOutput?        @relation(fields: [aiOutputId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([financialPeriodId])
  @@map("investor_updates")
}

enum InvestorUpdateStatus {
  draft
  under_review
  approved
  released
  archived
}
// =============================================================================
// Pricing Intelligence (docs/22 PRD) — DP-1 foundation. Setup data only in
// this phase: no competitor website is contacted and no BigCommerce price is
// ever written from this module without pricing.writebacks + external
// writebacks + permission + approval + audit (future DP-6).
// =============================================================================

model PricingCompetitor {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  baseUrl                  String
  enabled                  Boolean                   @default(true)
  country                  String?
  currency                 String                    @default("CAD")
  searchUrlTemplate        String?
  productUrlPattern        String?
  rateLimitPerHour         Int                       @default(60)
  termsReviewStatus        PricingTermsReviewStatus  @default(pending)
  requiresManualUrlMapping Boolean                   @default(false)
  notes                    String?                   @db.Text
  lastSuccessfulCheckAt    DateTime?
  lastFailedCheckAt        DateTime?
  failureCount             Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  observations   CompetitorPriceObservation[]
  productUrls    ProductCompetitorUrl[]

  @@index([enabled])
  @@map("pricing_competitors")
}

enum PricingTermsReviewStatus {
  pending
  reviewed_allowed
  reviewed_restricted
  disabled
}

model PricingRule {
  id                    String   @id @default(cuid())
  name                  String   @unique
  storeId               String?
  categoryId            String?
  productId             String?
  productVariantId      String?
  minCostMultiplier     Decimal  @default(1.40) @db.Decimal(6, 3)
  defaultUndercutAmount Decimal  @default(0.01) @db.Decimal(10, 2)
  defaultUndercutPct    Decimal? @db.Decimal(5, 2)
  maxIncreasePct        Decimal  @default(10.00) @db.Decimal(5, 2)
  maxDecreasePct        Decimal  @default(20.00) @db.Decimal(5, 2)
  dailyBatchSize        Int      @default(300)
  minConfidence         Decimal  @default(0.850) @db.Decimal(4, 3)
  evidenceFreshnessHours Int     @default(48)
  requiresApproval      Boolean  @default(true)
  autoApproveEligible   Boolean  @default(false)
  enabled               Boolean  @default(true)
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store          Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@index([storeId])
  @@map("pricing_rules")
}

model PricingRun {
  id             String               @id @default(cuid())
  storeId        String
  sourceType     PricingRunSourceType
  rankingBasis   String?
  lookbackWindow String?
  targetCount    Int?
  dailyBatchSize Int                  @default(300)
  status         PricingRunStatus     @default(draft)
  createdById    String?
  startedAt      DateTime?
  completedAt    DateTime?
  lastBatchAt    DateTime?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("PricingRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     PricingRunItem[]

  @@index([storeId])
  @@index([status])
  @@map("pricing_runs")
}

enum PricingRunSourceType {
  upload
  top_products
}

enum PricingRunStatus {
  draft
  queued
  running
  paused
  completed
  failed
  cancelled
}

model PricingRunItem {
  id                     String               @id @default(cuid())
  pricingRunId           String
  storeId                String
  productId              String?
  productVariantId       String?
  sku                    String
  productName            String?
  currentRegularPrice    Decimal?             @db.Decimal(12, 2)
  currentSalePrice       Decimal?             @db.Decimal(12, 2)
  currentEffectivePrice  Decimal?             @db.Decimal(12, 2)
  costPrice              Decimal?             @db.Decimal(12, 2)
  costSource             String?
  floorPrice             Decimal?             @db.Decimal(12, 2)
  lowestCompetitorPrice  Decimal?             @db.Decimal(12, 2)
  recommendedSalePrice   Decimal?             @db.Decimal(12, 2)
  recommendationType     String?
  confidence             Decimal?             @db.Decimal(4, 3)
  status                 PricingRunItemStatus @default(pending)
  blockedReason          String?
  lastCheckedAt          DateTime?
  metadata               Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  pricingRun     PricingRun                   @relation(fields: [pricingRunId], references: [id], onDelete: Cascade)
  store          Store                        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product        Product?                     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant ProductVariant?              @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  observations   CompetitorPriceObservation[]
  recommendations PriceRecommendation[]

  @@index([pricingRunId])
  @@index([status])
  @@index([sku])
  @@map("pricing_run_items")
}

enum PricingRunItemStatus {
  pending
  checked
  recommendation_ready
  approved
  rejected
  blocked
  written_back
  failed
}

model CompetitorPriceObservation {
  id                     String                    @id @default(cuid())
  pricingRunItemId       String
  competitorId           String
  competitorUrl          String
  observedRegularPrice   Decimal?                  @db.Decimal(12, 2)
  observedSalePrice      Decimal?                  @db.Decimal(12, 2)
  observedEffectivePrice Decimal?                  @db.Decimal(12, 2)
  currency               String?
  availability           String?
  shippingNote           String?
  taxNote                String?
  matchConfidence        Decimal?                  @db.Decimal(4, 3)
  extractionMethod       PricingExtractionMethod
  rawEvidenceText        String?                   @db.Text
  evidenceRef            String?
  checkedAt              DateTime?
  status                 PricingObservationStatus  @default(valid)
  errorMessage           String?                   @db.Text
  createdAt              DateTime                  @default(now())

  pricingRunItem PricingRunItem    @relation(fields: [pricingRunItemId], references: [id], onDelete: Cascade)
  competitor     PricingCompetitor @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  @@index([pricingRunItemId])
  @@index([competitorId])
  @@map("competitor_price_observations")
}

enum PricingExtractionMethod {
  direct_url
  search_template
  manual
  ai_assisted
}

enum PricingObservationStatus {
  valid
  invalid
  unavailable
  low_confidence
  failed
}

model PriceRecommendation {
  id                    String                    @id @default(cuid())
  pricingRunItemId      String
  oldRegularPrice       Decimal?                  @db.Decimal(12, 2)
  oldSalePrice          Decimal?                  @db.Decimal(12, 2)
  recommendedSalePrice  Decimal                   @db.Decimal(12, 2)
  floorPrice            Decimal?                  @db.Decimal(12, 2)
  costPrice             Decimal?                  @db.Decimal(12, 2)
  marginBefore          Decimal?                  @db.Decimal(5, 4)
  marginAfter           Decimal?                  @db.Decimal(5, 4)
  lowestCompetitorPrice Decimal?                  @db.Decimal(12, 2)
  undercutAmount        Decimal?                  @db.Decimal(10, 2)
  recommendationType    String
  reason                String?                   @db.Text
  requiresApproval      Boolean                   @default(true)
  status                PriceRecommendationStatus @default(draft)
  approvedById          String?
  approvedAt            DateTime?
  rejectedById          String?
  rejectedAt            DateTime?
  rejectionReason       String?
  expiresAt             DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  pricingRunItem PricingRunItem      @relation(fields: [pricingRunItemId], references: [id], onDelete: Cascade)
  approvedBy     User?               @relation("PriceRecommendationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy     User?               @relation("PriceRecommendationRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  writebackLogs  PriceWritebackLog[]

  @@index([pricingRunItemId])
  @@index([status])
  @@map("price_recommendations")
}

enum PriceRecommendationStatus {
  draft
  ready_for_review
  approved
  rejected
  expired
  written_back
  failed
}

model PriceWritebackLog {
  id               String               @id @default(cuid())
  recommendationId String
  storeId          String
  productId        String?
  productVariantId String?
  sourceSystem     String?
  sourceProductId  String?
  sourceVariantId  String?
  oldRegularPrice  Decimal?             @db.Decimal(12, 2)
  oldSalePrice     Decimal?             @db.Decimal(12, 2)
  newSalePrice     Decimal              @db.Decimal(12, 2)
  status           PriceWritebackStatus @default(queued)
  requestPayload   Json?
  responsePayload  Json?
  errorMessage     String?              @db.Text
  writtenById      String?
  writtenAt        DateTime?
  rollbackPayload  Json?
  rollbackAt       DateTime?
  createdAt        DateTime             @default(now())

  recommendation PriceRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  writtenBy      User?               @relation("PriceWritebackWriter", fields: [writtenById], references: [id], onDelete: SetNull)

  @@index([recommendationId])
  @@index([status])
  @@map("price_writeback_logs")
}

enum PriceWritebackStatus {
  queued
  succeeded
  failed
  rolled_back
}

model ProductCompetitorUrl {
  id               String                     @id @default(cuid())
  productId        String?
  productVariantId String?
  competitorId     String
  competitorUrl    String
  matchConfidence  Decimal?                   @db.Decimal(4, 3)
  verifiedAt       DateTime?
  verifiedById     String?
  status           ProductCompetitorUrlStatus @default(active)
  notes            String?                    @db.Text
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  product        Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  competitor     PricingCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  verifiedBy     User?             @relation("ProductCompetitorUrlVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([competitorId, competitorUrl])
  @@index([productId])
  @@index([productVariantId])
  @@map("product_competitor_urls")
}

enum ProductCompetitorUrlStatus {
  active
  needs_review
  disabled
}
