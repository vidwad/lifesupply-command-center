model Campaign {
  id              String         @id @default(cuid())
  name            String
  campaignType    String // email, social, paid, content, lifecycle
  sourceSystem    String?
  sourceId        String?
  status          CampaignStatus @default(draft)
  subject         String?
  /// Draft body (HTML or plain text). For approval-gated campaigns this is
  /// what the AI generated and the marketer reviewed; the actual Mailchimp
  /// payload is built from this when (and only when) export is approved.
  bodyDraft       String?        @db.Text
  audienceSummary String?
  /// Snapshot of customer IDs included at draft time. Stored so the
  /// approver sees exactly who would receive the message — even if the
  /// reactivation segment shifts later.
  audienceSnapshot Json?
  /// Pointer to the AiOutput row that drafted this campaign, when AI-drafted.
  aiOutputId      String?
  /// Consent-eligibility snapshot taken at draft time (Phase 4). Approval is
  /// refused when absent — approvers must see the compliance posture.
  eligibilitySnapshot Json?
  /// Structured campaign-builder plan (Phase 5): objective, streams, cleanup +
  /// consent review, product/offer strategy, sequences, calendar, task refs.
  plan Json?
  /// Program → track link (Phase 5): consumer/B2B track campaigns point at
  /// their parent reactivation-program record.
  parentCampaignId String?
  /// Mailchimp export lifecycle. "not_queued" by default; only flips after
  /// approval + the mailchimp.send feature flag is on.
  mailchimpExportStatus  String?  @default("not_queued") // not_queued, queued, sent, failed
  mailchimpExportedAt    DateTime?
  mailchimpExternalId    String?
  mailchimpExportError   String?  @db.Text
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  metrics        CampaignMetrics[]
  aiOutput       AiOutput?         @relation(fields: [aiOutputId], references: [id], onDelete: SetNull)
  parentCampaign Campaign?         @relation("CampaignTracks", fields: [parentCampaignId], references: [id], onDelete: SetNull)
  trackCampaigns Campaign[]        @relation("CampaignTracks")

  @@unique([sourceSystem, sourceId])
  @@index([status])
  @@index([mailchimpExportStatus])
  @@index([parentCampaignId])
  @@map("campaigns")
}

enum CampaignStatus {
  draft
  scheduled
  sent
  paused
  cancelled
}

model CampaignMetrics {
