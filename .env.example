# LifeSupply Command Center — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit a populated .env file.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
# Which deployed environment this process belongs to (staging | production).
# Set by the Render blueprints; surfaced by /api/health as `environment`.
# Leave unset for local development.
# DEPLOY_ENV=staging
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# LifeSupply public website host routing
# -----------------------------------------------------------------------------
# Comma-separated public domains served by the same repository. On these hosts,
# root corporate routes are public while dashboard/admin/internal API routes are
# blocked by src/proxy.ts. Do not include the internal Command Center hostname.
PUBLIC_SITE_HOSTS=lifesupplyhealth.com,www.lifesupplyhealth.com
# Local-only flag for reviewing the public application on localhost. Never set
# this in a shared staging or production environment.
# PUBLIC_SITE_MODE=true
# The external Render Command Center host used by the Vercel public site for
# dashboard login. Vercel receives no internal auth or database credentials.
NEXT_PUBLIC_COMMAND_CENTER_URL=https://lifesupply-cc-web.onrender.com

# -----------------------------------------------------------------------------
# Database (Postgres)
# Local dev: docker compose postgres → both URLs can be the same.
# Vercel + Neon: DATABASE_URL is the *pooled* connection (PgBouncer), and
# DIRECT_URL is the direct primary used by `prisma migrate deploy`.
# Prisma falls back to DATABASE_URL when DIRECT_URL is unset.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifesupply_cc?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lifesupply_cc?schema=public

# -----------------------------------------------------------------------------
# Auth.js v5 — Phase 1
# Generate AUTH_SECRET with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=replace-with-random-32-byte-base64-secret
AUTH_URL=http://localhost:3000
# Set to true on Vercel / any host behind a proxy where AUTH_URL may
# differ from the actual request host. Leave unset locally.
# AUTH_TRUST_HOST=true

# -----------------------------------------------------------------------------
# Encrypted credential vault — docs/06 §8
# Required for the /admin/integrations UI to store secrets in the DB.
# Generate with: openssl rand -base64 32  (must decode to exactly 32 bytes)
# Without this set, integrations fall back to env vars only.
# -----------------------------------------------------------------------------
MASTER_ENCRYPTION_KEY=replace-with-32-byte-base64-master-key

# -----------------------------------------------------------------------------
# Inngest — background job queue (BigCommerce customer + order sync)
# The web app SENDS events; the worker (`pnpm worker`) PROCESSES them.
#
# Local dev: leave BOTH blank. The bundled Inngest dev server runs keyless —
# start it alongside the app and run `pnpm worker` to register functions.
#
# Production: create an app at https://app.inngest.com and copy its keys
# (Manage → Keys). The web service needs INNGEST_EVENT_KEY to publish;
# the worker needs BOTH keys to register + receive invocations.
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Integration env vars (optional — env wins over the vault when both are set)
# Leave blank in production if you'll manage these from /admin/integrations.
# -----------------------------------------------------------------------------

# BigCommerce
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_API_TOKEN=
BIGCOMMERCE_CLIENT_ID=

# QuickBooks Online
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=

# Google Analytics 4
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# File storage (Cloudflare R2 / S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Outbound email — Resend. Required for live investor-update distribution.
# When unset, releaseInvestorUpdate() falls back to the stub path.
RESEND_API_KEY=
INVESTOR_FROM_EMAIL=
INVESTOR_FROM_NAME=LifeSupply

# Audit log retention (days). Default 365, minimum 30.
AUDIT_RETENTION_DAYS=365

# Supplier portal automation (BBM01)
# When unset the Playwright runner hits the in-repo mock portal at
# /dev/mock-portals/bbm01/index.html. Set to the live URL in production.
# Browsers must be installed once per host: pnpm exec playwright install chromium
SUPPLIER_PORTAL_BBM01_URL=

# Optional model overrides (env wins over /admin/ai-settings)
ANTHROPIC_MODEL=
OPENAI_MODEL=
# Product Studio uses Responses web search and the Images edit API.
# The workflow requests 2048x2048; preserve gpt-image-2 unless a tested
# replacement supports arbitrary square sizes and high-fidelity multi-image editing.
OPENAI_IMAGE_MODEL=gpt-image-2

# Public site (Vercel) reads governed content from the Command Center published-only
# endpoints. Defaults to NEXT_PUBLIC_COMMAND_CENTER_URL, then the Render origin.
# PUBLIC_CONTENT_API_ORIGIN=https://lifesupply-cc-web.onrender.com
# Command Center (Render): hosts an approved public document file may be served from.
# Empty means no file can be attached; records publish as metadata (DEC-03 pending).
# PUBLIC_DOCUMENT_HOSTS=

# Public inquiry intake (Stage 7). Both feature flags default OFF in the database.
# Origins allowed to POST to /api/public/v1/inquiries (the public site), comma-separated.
# PUBLIC_SITE_ORIGINS=https://lifesupplyhealth.com,https://www.lifesupplyhealth.com
# Retention period for inquiry records in days (default 180 until WEB-07 sets one).
# PUBLIC_INQUIRY_RETENTION_DAYS=180
# Salt for the hashed client address used by the rate limiter (never the raw address).
# PUBLIC_INQUIRY_HASH_SALT=
# When set, every acknowledgment and owner notification goes to this address instead
# of the visitor or the owner: the controlled test sink required before real sends.
# PUBLIC_INQUIRY_SINK_EMAIL=
