# Line endings are LF in the repository and in every working copy (BD-01).
# Windows checkouts with core.autocrlf=true used to receive CRLF files, which
# made `pnpm format:check` fail locally while CI stayed green.
* text=auto eol=lf

# Binary assets: never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.webm binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
